# Optional non-secret local defaults. Never put MFL credentials in this file.
MFL_YEAR=2026
MFL_LEAGUE_ID=
MFL_FRANCHISE_ID=

# Production: generate a Fernet key and store it only in Railway Variables.
# WP_SESSION_SECRET=
# With a Railway volume mounted at /data:
# WP_SESSION_DB=/data/sessions.sqlite3

# Optional free ESPN weekly ranking format: PPR or STANDARD. No key is needed.
# WP_ESPN_RANKING_FORMAT=PPR
